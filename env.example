# Database
DATABASE_URL=postgresql://luxe_user:your_secure_password@localhost:5432/luxe_candles

# API
API_V1_PREFIX=/v1
PROJECT_NAME=Luxe Candles API
DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# M-Pesa (Safaricom Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=http://localhost:8000/v1/webhooks/mpesa/callback

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Luxe Candles
ADMIN_EMAIL=admin@yourdomain.com

# Admin
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=admin123

# Frontend
FRONTEND_URL=http://localhost:3000
